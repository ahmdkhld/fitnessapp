# Local development points at the NestJS backend running on localhost.
# For a production deploy (see DEPLOY.md), set this to the Render URL:
#   API_BASE_URL=https://nutritrack-api-xxxx.onrender.com/api
#
# Vercel reads this value in both Production and Preview environments.
API_BASE_URL=http://localhost:3000/api

# Sentry DSNs — leave blank for local dev. For Vercel, set the same DSN
# in both NEXT_PUBLIC_SENTRY_DSN (client bundle) and SENTRY_DSN (server).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
