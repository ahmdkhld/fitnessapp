DATABASE_URL="postgresql://nutritrack:nutritrack@localhost:5432/nutritrack?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-too"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000

# Comma-separated list of allowed CORS origins.
# In production, set to your real frontend URL(s).
CORS_ORIGINS="http://localhost:3001"
NODE_ENV=development
S3_BUCKET="nutritrack-uploads"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_PUBLIC_BASE=""
SENTRY_DSN=""
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Used to verify Google/Apple id tokens against the providers' JWKS endpoints
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# SMTP for password reset + coach invites. Leave SMTP_HOST blank in dev
# to log emails to the console.
APP_URL="http://localhost:3001"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NutriTrack <noreply@nutritrack.app>"

# Skips the workout exercise + plan template seed at module init.
# Useful for tests and read-only replicas where the boot-time write
# would either be a waste or fail.
SKIP_WORKOUT_SEED="false"
